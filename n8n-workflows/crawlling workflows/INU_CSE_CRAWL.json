{
"name": "INU 크롤링 - 컴퓨터공학부",
"nodes": [
{
"parameters": { "rule": { "interval": [{ "field": "hours", "hoursInterval": 1 }] } },
"name": "매시간 트리거",
"type": "n8n-nodes-base.scheduleTrigger",
"typeVersion": 1.2,
"position": [240, 300]
},
{
"parameters": {
"url": "https://cse.inu.ac.kr/isis/3519/subview.do",
"options": { "timeout": 15000 },
"headerParameters": { "parameters": [{ "name": "User-Agent", "value": "UnivNoticeBot/1.0" }] }
},
"name": "컴공 공지 GET",
"type": "n8n-nodes-base.httpRequest",
"typeVersion": 4.2,
"position": [460, 300],
"retryOnFail": true,
"maxTries": 3,
"waitBetweenTries": 30000
},
{
"parameters": {
"model": "claude-haiku-4-5-20251001",
"prompt": "아래 HTML에서 컴퓨터공학부 공지사항 목록을 추출하여 JSON 배열로 반환하라.\n\n출력 형식 (JSON 배열만 반환):\n[{\"source_id\":3, \"external_id\":\"번호\", \"title\":\"제목\", \"url\":\"전체URL\", \"category\":\"DEPARTMENT\", \"posted_date\":\"YYYY-MM-DD\"}]\n\n고정 공지 제외. 상대경로는 https://cse.inu.ac.kr 붙이기.\n\nHTML:\n{{ $json.body }}",
"options": { "maxTokens": 2000, "temperature": 0 }
},
"name": "LLM 파싱",
"type": "@n8n/n8n-nodes-langchain.lmChatAnthropic",
"typeVersion": 1,
"position": [680, 300]
},
{
"parameters": {
"jsCode": "const llmOutput = $input.first().json.text || $input.first().json.output || '';\ntry {\n  const jsonMatch = llmOutput.match(/\\[[\\s\\S]*\\]/);\n  if (!jsonMatch) throw new Error('No JSON array found');\n  const notices = JSON.parse(jsonMatch[0]);\n  return [{ json: { notices, count: notices.length, status: 'SUCCESS' } }];\n} catch (e) {\n  return [{ json: { notices: [], count: 0, status: 'PARSE_FAILED', error: e.message } }];\n}"
},
"name": "JSON 추출",
"type": "n8n-nodes-base.code",
"typeVersion": 2,
"position": [900, 300]
},
{
"parameters": { "conditions": { "number": [{ "value1": "={{ $json.count }}", "operation": "larger", "value2": 0 }] } },
"name": "공지 확인",
"type": "n8n-nodes-base.if",
"typeVersion": 2,
"position": [1120, 300]
},
{
"parameters": {
"method": "POST",
"url": "http://api:8080/internal/v1/notices/batch",
"sendHeaders": true,
"headerParameters": { "parameters": [{ "name": "X-API-Key", "value": "={{ $env.INTERNAL_API_KEY }}" }, { "name": "Content-Type", "value": "application/json" }] },
"sendBody": true,
"bodyParameters": { "parameters": [{ "name": "body", "value": "={{ JSON.stringify($json.notices) }}" }] }
},
"name": "Spring Boot 저장",
"type": "n8n-nodes-base.httpRequest",
"typeVersion": 4.2,
"position": [1340, 200]
}
],
"connections": {
"매시간 트리거": { "main": [[{ "node": "컴공 공지 GET", "type": "main", "index": 0 }]] },
"컴공 공지 GET": { "main": [[{ "node": "LLM 파싱", "type": "main", "index": 0 }]] },
"LLM 파싱": { "main": [[{ "node": "JSON 추출", "type": "main", "index": 0 }]] },
"JSON 추출": { "main": [[{ "node": "공지 확인", "type": "main", "index": 0 }]] },
"공지 확인": { "main": [[{ "node": "Spring Boot 저장", "type": "main", "index": 0 }], []] }
},
"settings": { "timezone": "Asia/Seoul" },
"tags": [{ "name": "crawling" }, { "name": "inu" }, { "name": "department" }]
}